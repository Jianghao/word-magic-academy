          ],
          "memory": [
            { "icon": "🔤", "text": "<b>Jan</b>-u-<b>ary</b> → 4个音节：Jan(詹)+u(优)+ar(阿)+y(伊)。Jan像女孩名\"Jane\"，想象新年Jane收到礼物🎁" },
            { "icon": "🔊", "text": "<b>/dʒæn/</b>像中文\"站\"的翘舌音，<b>-uary</b>固定读作\"you-airy\"。慢读三遍：Jan-u-ar-y！" },
            { "icon": "📖", "text": "以罗马神<b>Janus</b>（雅努斯）命名。他有两张脸👀，一张回望过去，一张看向未来——就像一月既告别旧年又迎接新年！" }
          ]
        },
        {
          "id": "february", "word": "February", "phonetic": "/ˈfeb.ruː.er.i/",
          "chinese": "二月", "emoji": "💝", "pos": "名词", "season": "winter",
          "heroGradient": ["#F5D5E0", "#FBE8EF"],
          "sentences": [
            { "en": "<span class='hl'>February</span> is the shortest month.", "zh": "二月是最短的月份。" },
            { "en": "Valentine's Day is on <span class='hl'>February</span> 14th.", "zh": "情人节在二月十四日。" }
          ],
          "memory": [
            { "icon": "🔤", "text": "<b>Feb</b>-ru-<b>ary</b> → Feb像\"飞吧\"🕊️，r在b后面不要忘！二月很短，\"飞一样\"就过去了。" },
            { "icon": "🔊", "text": "<b>/feb/</b>嘴巴轻轻咬下唇，\"飞吧\"。注意第一个r在Feb后面，第二个r在-ary前面——<b>两个r</b>！" },
            { "icon": "📖", "text": "来自拉丁语<b>\"februa\"</b>（净化仪式）。古罗马人在二月举行大扫除和净化祭祀🧹。闰年时二月有29天——叫<b>Leap Day</b>🐸！" }
          ]
        },
        {
          "id": "march", "word": "March", "phonetic": "/mɑːrtʃ/",
          "chinese": "三月", "emoji": "🌸", "pos": "名词", "season": "spring",
          "heroGradient": ["#F5E8D5", "#FDF3E8"],
          "sentences": [
            { "en": "Spring begins in <span class='hl'>March</span>.", "zh": "春天从三月开始。" },
            { "en": "The flowers start to bloom in <span class='hl'>March</span>.", "zh": "三月花儿开始绽放。" }
          ],
          "memory": [
            { "icon": "🔤", "text": "<b>Mar+ch</b> → 只有5个字母！\"Mar\"像\"马儿\"🐴，ch是轻声。三月春风似马蹄轻快。" },
            { "icon": "🔊", "text": "<b>/mɑːrtʃ/</b> → \"马儿吃\"——舌头最后顶到上颚发出\"ch\"音。和\"March\"(行军)发音一模一样！" },
            { "icon": "📖", "text": "以罗马战神<b>Mars</b>⚔️命名！古罗马人认为三月天气转暖，是出门打仗的好季节。火星的英文也是Mars，因为火星是红色的战争之星！" }
          ]
        },
        {
